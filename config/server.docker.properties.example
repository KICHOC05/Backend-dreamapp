# Database variables configuration for Docker
database.jdbc.protocol=jdbc:firebird
database.host=firebird5-engine
database.port=3050
database.name=db_dashboard
database.user=sysdba
database.password=
database.encoding=UTF8

# External OpenAI-compatible AI provider (key comes from AI_API_KEY)
ai.base-url=https://api.groq.com/openai/v1
ai.model=openai/gpt-oss-20b
ai.api-key=

# Firebase variables configuration for Docker
firebase.project-id=
firebase.url-functions=
firebase.host=localhost:8080
